# ── Supabase (se ven en el navegador, no son secretas) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Google Gemini (SECRETA: solo en el servidor, nunca con NEXT_PUBLIC_) ──
# Clave gratis en aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo principal de Gemini (si falla, se prueban otros solos)
GEMINI_MODEL=

# ── Recordatorio a la mañana (notificaciones Web Push) ──
# Claves VAPID: se generan con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Clave que comparten Supabase (pg_cron) y la app para mandar los recordatorios.
# La misma va guardada en Supabase Vault como "recordatorio_secret" (ver supabase/schema.sql).
RECORDATORIO_SECRET=
